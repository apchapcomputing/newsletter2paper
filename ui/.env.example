# Supabase Configuration (Frontend - REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostHog analytics (EU cloud). Optional: without the key, analytics is off.
# The key is public; it ships in the browser bundle.
NEXT_PUBLIC_POSTHOG_KEY=
# Used by server-side error capture (instrumentation.js); the browser goes through /ingest.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Source map upload at build time (Vercel only): a personal API key with error tracking write scope.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
