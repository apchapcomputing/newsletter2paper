# Copy to .env at the repo root. docker compose reads it for the API container (and Caddy in production).
# For running the API directly with uvicorn instead, see newsletter2paper/.env.example.

# --- Supabase (REQUIRED) -------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# sb_secret_... key. Bypasses RLS: backend only, never expose it.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Direct Postgres connection string, used by the scheduler (it needs FOR UPDATE SKIP LOCKED, which
# the REST client cannot do). Supabase dashboard > Connect > Session pooler or Direct connection.
# Without it the API starts but automatic delivery is disabled ("scheduler: disabled" in /health).
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-id:your-database-password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Go PDF service (OPTIONAL) -------------------------------------------------------------------
GO_PDF_CONTAINER=pdf-maker

# --- Email delivery via Resend (https://resend.com) ----------------------------------------------
RESEND_API_KEY=your-resend-api-key
# Must be on a domain verified in Resend (SPF and DKIM), with a DMARC record in DNS.
EMAIL_FROM="Newsletter2Paper <newsletters@newsletter2paper.xyz>"

# --- Public address of this API (production) -----------------------------------------------------
# Used in links inside delivery emails: open tracking (/d/...), address confirmation (/email/verify)
# and one-click unsubscribe (/u/...). Must be https:// on a real hostname: Gmail ignores one-click
# unsubscribe over plain HTTP, and a bare IP in a link looks like phishing. Leave empty locally;
# emails then link straight to the PDF and carry no unsubscribe link.
# Apply migrations 20261008000000 (opened_at) and 20261010000000 (verification) first.
PUBLIC_API_URL=
# Hostname Caddy gets a Let's Encrypt certificate for and serves the API on. Needs a DNS A record
# pointing at the droplet. Set PUBLIC_API_URL to https://<this hostname>. See DEPLOY_HTTPS.md.
API_DOMAIN=
# Production only: starts the Caddy container. Leave unset locally so `docker compose up` does not bind ports 80/443.
# COMPOSE_PROFILES=prod

# --- Internal routes (OPTIONAL) ------------------------------------------------------------------
# Token for /pdf/test-storage, /pdf/cleanup and /pdf/memory/stats; they return 404 while unset.
ADMIN_API_TOKEN=

# --- Analytics and error tracking (OPTIONAL; off without the key) --------------------------------
# Same project key as the UI.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Scheduler tuning (OPTIONAL; these are the defaults) -----------------------------------------
# How long a claimed issue stays locked before another worker may take it over. The API refuses to
# start if this is shorter than the worst-case run (RSS budget + PDF render + email).
# SCHEDULER_LOCK_TIMEOUT_MINUTES=15
# Attempts per edition before giving up and telling the owner.
# SCHEDULER_MAX_ATTEMPTS=5
# Seconds budgeted for fetching feeds in one run (part of the lock-timeout check above).
# SCHEDULER_RSS_BUDGET_SECONDS=300
# On shutdown, how long to wait for the run in progress. Keep it below docker-compose's stop_grace_period (120s).
# SCHEDULER_SHUTDOWN_GRACE_SECONDS=100
# Minimum gap between two "Send now" requests for the same issue.
# SEND_NOW_COOLDOWN_MINUTES=10
