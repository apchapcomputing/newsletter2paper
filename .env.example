# Supabase Configuration (REQUIRED)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Go PDF Service Configuration (OPTIONAL)
GO_PDF_CONTAINER=pdf-maker

# Service Configuration (OPTIONAL)
PORT=8000

# Resend email delivery (https://resend.com)
RESEND_API_KEY=your-resend-api-key
# Must be a verified sender domain in your Resend account
EMAIL_FROM="Newsletter2Paper <newsletter@newsletter2paper.xyz>"
# PostHog analytics and error tracking (OPTIONAL; off without the key). Same project key as the UI.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Public URL of this API. When set, delivery emails link to {PUBLIC_API_URL}/d/{delivery_id}, which
# records the open and redirects to the PDF. Apply migration 20261007000000_delivery_opened_at first.
PUBLIC_API_URL=
