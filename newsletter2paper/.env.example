# Copy to newsletter2paper/.env to run the API directly (cd newsletter2paper && uvicorn main:app --reload).
# With docker compose, use the .env.example at the repo root instead; it lists every setting.

# Supabase (REQUIRED)
SUPABASE_URL=https://your-project-id.supabase.co
# sb_secret_... key. Bypasses RLS: backend only, never expose it.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Direct Postgres connection, needed only to run the scheduler (automatic delivery).
SUPABASE_DATABASE_URL=

# Email delivery (OPTIONAL locally; sends fail with a "config:" error without a key)
RESEND_API_KEY=
EMAIL_FROM="Newsletter2Paper <newsletters@newsletter2paper.xyz>"

# Leave empty locally. In production: https://api.<your domain> (see the root .env.example).
PUBLIC_API_URL=

# Analytics (OPTIONAL)
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
